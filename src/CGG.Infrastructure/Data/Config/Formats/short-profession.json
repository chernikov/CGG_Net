{
  "description": "Short format – intermediate steps (steps 1 to N-1). Returns essential match info only. Exactly 3 top matches.",
  "format": {
    "type": "object",
    "properties": {
      "matches": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "object",
          "required": ["title", "matchPercentage"],
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "description": "Profession name"
            },
            "matchPercentage": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Match score (0-100)"
            }
          }
        }
      }
    },
    "required": ["matches"]
  }
}
