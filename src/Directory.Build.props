<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Label="Package Versions">
    <!-- Microsoft Packages -->
    <MicrosoftAspNetCoreVersion>10.0.2</MicrosoftAspNetCoreVersion>
    <MicrosoftEntityFrameworkCoreVersion>10.0.2</MicrosoftEntityFrameworkCoreVersion>
    <MicrosoftExtensionsIdentityStoresVersion>9.0.1</MicrosoftExtensionsIdentityStoresVersion>
    <MicrosoftOpenApiVersion>2.5.0</MicrosoftOpenApiVersion>
    
    <!-- Third Party Packages -->
    <AutoMapperVersion>12.0.1</AutoMapperVersion>
    <AutoMapperExtensionsVersion>12.0.1</AutoMapperExtensionsVersion>
    <FluentValidationVersion>12.1.1</FluentValidationVersion>
    <SwashbuckleVersion>10.1.1</SwashbuckleVersion>
    <MailKitVersion>4.14.1</MailKitVersion>
    <MimeKitVersion>4.14.0</MimeKitVersion>
  </PropertyGroup>

</Project>
